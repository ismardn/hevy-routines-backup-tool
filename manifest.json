{
  "manifest_version": 3,
  "name": "Hevy Routines Backup Tool",
  "version": "1.0",
  "description": "Export your Hevy routines to a structured text file. Created by isma & Gemini 3.1 Pro.",
  "action": {
    "default_title": "Export routines"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://www.hevy.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}